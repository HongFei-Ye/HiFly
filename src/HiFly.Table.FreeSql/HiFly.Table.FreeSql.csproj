<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>HiFly.Table</RootNamespace>
    <AssemblyName>HiFly.Table.FreeSql</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>HiFly.Table.FreeSql</PackageId>
    <Version>0.1.0-preview</Version>
    <Authors>HiFly Contributors</Authors>
    <Description>FreeSQL adapter for HiFly.Table — registers FreeSqlTItemDataSourceFactory via [ModuleInitializer]. TItemTable consumes IFreeSql singleton via DI for query/save/delete.</Description>
    <PackageTags>blazor;bootstrap;table;freesql;adapter</PackageTags>
    <PackageProjectUrl>https://github.com/HongFei-Ye/HiFly</PackageProjectUrl>
    <RepositoryUrl>https://github.com/HongFei-Ye/HiFly.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BootstrapBlazor" Version="10.5.1" />
    <PackageReference Include="FreeSql" Version="3.5.105" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HiFly.Table.Abstractions\HiFly.Table.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
